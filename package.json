{
  "name": "suytools-taller-overlay",
  "version": "0.6.9",
  "description": "SuyTools overlay con taller, Badulak, atajos personalizados y temas de color radiales",
  "author": "SuyTools",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.suytools.taller",
    "productName": "SuyTools Taller",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "assets/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "SuyTools-Taller-Setup-${version}.${ext}",
      "uninstallDisplayName": "SuyTools Taller",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "suysuy-beep",
        "repo": "overlayfv",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
